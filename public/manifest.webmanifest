{
  "name": "1venue — live events & meetings",
  "short_name": "1venue",
  "description": "Host and discover live talk shows, seminars, sermons and meetings.",
  "id": "/",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#07090f",
  "theme_color": "#2563eb",
  "categories": ["social", "productivity", "education", "lifestyle"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/brand/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Create event", "url": "/create", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Discover live", "url": "/discover?status=live", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Bible", "url": "/bible", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
