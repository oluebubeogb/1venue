# ---------- core ----------
APP_NAME=1venue
# The one public address of the app (no trailing slash). Everything else is derived from it:
# email links, the Google redirect ${PUBLIC_URL}/auth/google/callback, the default mail sender.
PUBLIC_URL=https://1venue.live
# Origins allowed to call the API cross-origin with cookies (comma separated). Empty = PUBLIC_URL only.
CORS_ORIGINS=
# Optional: 301-redirect every other host name (e.g. www.1venue.live) to this one. Empty = off.
# /health, /ready, /api/health and /metrics are never redirected. See docs/DEPLOY-1venue.live.md.
CANONICAL_HOST=1venue.live
PORT=3000
# Long random string (openssl rand -hex 32). Required in production. Signs the short-lived
# access token, room credentials and the Google sign-in flow cookie. Rotating it is safe:
# signed-in browsers renew from their refresh token (stored hashed in the database).
JWT_SECRET=
TRUST_PROXY=true
RATE_LIMIT_PER_MIN=240

# ---------- memory & live-room limits (Contabo-sized defaults) ----------
# V8 heap in MB. Keep ~65% of the container limit (APP_MEM_LIMIT): 2048 for 3g, 4096 for 6g.
NODE_MAX_OLD_SPACE_MB=2048
APP_MEM_LIMIT=3g
# Ping every WebSocket this often; sockets that miss a pong are closed (0 = off)
WS_HEARTBEAT_MS=30000
# Forget participants who left this long ago (hosts/co-hosts are kept). 0 = never
LEFT_PARTICIPANT_PRUNE_MINUTES=10
# Shared whiteboard: strokes kept per room / shared board, points kept per stroke
WB_MAX_STROKES=1000
WB_MAX_POINTS=2000
# Screen timeline snapshots per room, and max size of one snapshot (data-URL characters)
SCREEN_TIMELINE_MAX_ITEMS=10
SCREEN_TIMELINE_MAX_CHARS=1500000
# Graceful restarts: live rooms are saved on SIGTERM and restored when people reconnect.
# Snapshots older than this are ended instead of restored.
MEETING_RESTORE_MAX_MINUTES=30
SHUTDOWN_GRACE_MS=1500

# ---------- monitoring ----------
# GET /metrics (Prometheus text format) with header "Authorization: Bearer <METRICS_TOKEN>".
# Empty = /metrics is disabled (404). Generate with: openssl rand -hex 24
METRICS_TOKEN=
# One compact "[metrics] rss=… heap=… rooms=… participants=… sockets=… dead_sockets_total=… uptime=…" log line.
METRICS_LOG=true
METRICS_LOG_INTERVAL_MS=60000

# ---------- database (PostgreSQL; migrations run on boot) ----------
DATABASE_URL=postgres://venue:change-me@db:5432/venue
# Local testing only: set DB_DRIVER=sqlite and optionally SQLITE_PATH.
# Production keeps the default DB_DRIVER=postgres and DATABASE_URL above.
# DB_DRIVER=sqlite
# SQLITE_PATH=./data/venue.sqlite
AUTO_MIGRATE=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# docker-compose only:
PG_MEM_LIMIT=1g
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=60
PG_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_DB=venue
POSTGRES_USER=venue
POSTGRES_PASSWORD=change-me
# Only used if you add a host port mapping yourself
APP_PORT=8080

# ---------- accounts & sign-in (docs/AUTH.md) ----------
# Email + password sign-up on /signup (false = only existing users and Google sign-in)
ALLOW_LOCAL_SIGNUP=true
# Access token lifetime (minutes) and refresh session lifetime (days of inactivity / absolute max)
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_SESSION_MAX_DAYS=90
# bcrypt cost (4-15). 12 is ~250 ms per hash on a modern core.
BCRYPT_COST=12
AUTH_PASSWORD_MIN=8
# false = people can use the app before confirming their email (they see a banner). true = they must confirm first.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_VERIFY_TTL_HOURS=48
AUTH_RESET_TTL_MIN=60
# Sign-in/sign-up/reset requests per minute per IP (per process)
AUTH_RATE_PER_MIN=20
# Cookies are Secure (__Host- prefixed) unless PUBLIC_URL starts with http:// (local dev). Override only if you must.
# AUTH_COOKIE_SECURE=true

# --- Continue with Google (empty = button hidden) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback  e.g. https://1venue.live/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false = Google only signs in existing accounts (matched by verified email), never creates new ones
GOOGLE_ALLOW_SIGNUP=true

# ---------- email (any SMTP provider; examples in docs/AUTH.md) ----------
# Empty SMTP_HOST = no email is sent. Outside production the links are printed to the log instead.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS). Default: true only when SMTP_PORT=465. 587 uses STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# From address; must be allowed by your provider (a verified domain/sender). Default: "1venue <no-reply@PUBLIC_URL host>"
MAIL_FROM="1venue <no-reply@1venue.live>"
MAIL_REPLY_TO=
# Print email links to the log when SMTP is not set (default: on outside production)
# MAIL_LOG_LINKS=true

# ---------- LiveKit (audio/video) ----------
# LiveKit runs as its own Coolify resource from the separate livekit-server repo
# (see docs/livekit-coolify.md). Use the API key/secret pair you created for 1venue there.
LIVEKIT_URL=wss://rtc.1venue.live
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMULCAST=true
DYNACAST=true
ADAPTIVE_STREAM=true
VIDEO_RESOLUTION=720p
VIDEO_MAX_BITRATE=1200000
VIDEO_MAX_FPS=24
SCREEN_MAX_BITRATE=1200000
SCREEN_MAX_FPS=12
AUDIO_PRESET=speech
MAX_PARTICIPANTS=50
MAX_AUDIENCE=300
DEFAULT_SPEAKER_SEATS=4
MEETING_INACTIVITY_HOURS=12

# ---------- AI (two OpenAI-compatible providers, each falls back to the other) ----------
# RunPod serverless vLLM example: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
AI_PRIMARY_NAME=runpod
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_SECONDARY_NAME=secondary
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=45000
# true = canned replies for local testing, no provider needed
AI_MOCK=false

# ---------- Speech-to-text ----------
# Any OpenAI-compatible POST {BASE_URL}/audio/transcriptions endpoint works. 1venue does NOT run
# a speech model itself (Contabo has no GPUs). Pick one:
#   Groq (cheapest hosted):  STT_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
#                            STT_SECONDARY_MODEL=whisper-large-v3-turbo   STT_SECONDARY_API_KEY=<groq key>
#   OpenAI:                  STT_SECONDARY_BASE_URL=https://api.openai.com/v1  STT_SECONDARY_MODEL=whisper-1
#   RunPod GPU Pod running speaches (ghcr.io/speaches-ai/speaches:latest-cuda, port 8000):
#                            STT_PRIMARY_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
#                            STT_PRIMARY_MODEL=Systran/faster-whisper-large-v3  STT_PRIMARY_API_KEY=<any non-empty>
#   Self-hosted N-ATLaS (optional, separate box): stt-sidecar/docker-compose.yml -> http://<host>:8000/v1
# Nothing configured = browsers fall back to the free Web Speech API.
# auto = primary -> secondary -> browser Web Speech API
STT_PROVIDER=auto
STT_PRIMARY_NAME=N-ATLaS
STT_PRIMARY_BASE_URL=
STT_PRIMARY_API_KEY=
STT_PRIMARY_MODEL=NCAIR1/NigerianAccentedEnglish
STT_SECONDARY_NAME=Whisper
STT_SECONDARY_BASE_URL=
STT_SECONDARY_API_KEY=
STT_SECONDARY_MODEL=whisper-1
STT_CHUNK_SECONDS=8
STT_MAX_CHUNK_BYTES=2000000
STT_TIMEOUT_MS=30000
# stt-sidecar only (gated NCAIR1 models: accept terms on Hugging Face)
HF_TOKEN=
STT_LANGS=en

# ---------- Text-to-speech (read-out icon) — see docs/TTS.md ----------
# Server-side proxy to Replicate. The token stays on the server; browsers never see it.
# Empty token = cloud read-out off (the icon only shows where the device has a voice for that exact language).
REPLICATE_API_TOKEN=
# Model id: official model "owner/name" (or pin a version with "owner/name:versionhash")
TTS_REPLICATE_MODEL=google/gemini-3.8-flash-tts
# REPLICATE_API_BASE=https://api.replicate.com/v1
# Voice (one of the model's 30 voices: Kore, Puck, Charon, Zephyr, Aoede, ...) and audio format
TTS_VOICE=Kore
TTS_FORMAT=mp3
# Max characters per request (longer passages are split into chunks by the browser)
TTS_MAX_CHARS=1500
# New (uncached) generations per participant/user per minute. Cached audio is free and not limited.
TTS_RATE_PER_MIN=10
# Whole-server cap on newly generated characters per day (UTC). 0 = no cap.
TTS_DAILY_CHAR_LIMIT=200000
TTS_TIMEOUT_MS=90000
TTS_MAX_AUDIO_MB=20
# Languages the read-out icon is shown for (comma-separated ISO codes). Empty = every language
# the model documents (includes ig, ha, ar; NOT yo). Example to keep it tight: en,ig,ha,ar
TTS_LANGUAGES=

# ---------- storage (VPS disk by default; any S3-compatible works) ----------
STORAGE_DRIVER=local
DATA_DIR=/data
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=25
# Per-type limits (MB). 0 turns a type off. Video is off: it would stream through this server.
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_PDF_MB=20
UPLOAD_MAX_AUDIO_MB=10
UPLOAD_MAX_VIDEO_MB=0
UPLOAD_MAX_OTHER_MB=10
# Total stored per signed-in user / per guest, and per meeting (MB)
UPLOAD_USER_QUOTA_MB=250
UPLOAD_GUEST_QUOTA_MB=30
UPLOAD_MEETING_CAP_MB=150
# Upload rate limits per user (or IP for guests)
UPLOAD_RATE_PER_MIN=12
UPLOAD_RATE_PER_HOUR=120
# Inline (data URL) chat attachments over the socket. 0 = off (current clients upload files).
CHAT_INLINE_MAX_MB=0

# --- S3-compatible object storage (recommended: Cloudflare R2) ---
# Set STORAGE_DRIVER=s3 above to use it. Files uploaded earlier stay readable from STORAGE_DIR
# (each file row remembers its driver), so keep the /data volume after switching.
# Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (R2 > Overview > "S3 API")
#   S3_REGION=auto
#   S3_BUCKET=1venue-uploads
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from R2 > Manage API tokens (Object Read & Write, this bucket only)
#   S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_BASE_URL=https://files.1venue.live   (bucket custom domain; files then load from
#   Cloudflare, not this server). Leave empty to stream files through the app instead.
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. eu-west-1). Backblaze B2 / MinIO: their S3 endpoint.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------- Bible ----------
BIBLE_API_BASE=https://bible.helloao.org/api
BIBLE_FALLBACK_BASE=https://bible-api.com
BIBLE_DEFAULT_TRANSLATION=eng_kjv
BIBLE_CACHE_DAYS=30
