# ---------- core ----------
APP_NAME=1venue
PUBLIC_URL=https://venue.collab.name.ng
PORT=3000
# Long random string (openssl rand -hex 32). Required in production.
JWT_SECRET=
JWT_TTL=30d
TRUST_PROXY=true
RATE_LIMIT_PER_MIN=240

# ---------- database (PostgreSQL; migrations run on boot) ----------
DATABASE_URL=postgres://venue:change-me@db:5432/venue
AUTO_MIGRATE=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# docker-compose only:
POSTGRES_DB=venue
POSTGRES_USER=venue
POSTGRES_PASSWORD=change-me
APP_PORT=3000

# ---------- Collab Accounts SSO ----------
ACCOUNTS_URL=https://accounts.collab.name.ng
ACCOUNTS_LOGIN_URL=https://accounts.collab.name.ng/login
ACCOUNTS_ACCESS_COOKIE=access_token
ACCOUNTS_REFRESH_COOKIE=refresh_token
# Optional: verify access_token locally (same secret Collab Accounts signs with). Otherwise /auth/me is called.
ACCOUNTS_JWT_SECRET=
COOKIE_DOMAIN=.collab.name.ng
# Allow email/password sign-up inside 1venue as well as SSO
ALLOW_LOCAL_SIGNUP=true

# ---------- LiveKit (audio/video) ----------
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMULCAST=true
DYNACAST=true
ADAPTIVE_STREAM=true
VIDEO_RESOLUTION=720p
VIDEO_MAX_BITRATE=1200000
VIDEO_MAX_FPS=24
SCREEN_MAX_BITRATE=2500000
SCREEN_MAX_FPS=15
AUDIO_PRESET=speech
MAX_PARTICIPANTS=50
MAX_AUDIENCE=300
DEFAULT_SPEAKER_SEATS=4
MEETING_INACTIVITY_HOURS=12

# ---------- AI (two OpenAI-compatible providers, each falls back to the other) ----------
# RunPod serverless vLLM example: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
AI_PRIMARY_NAME=runpod
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_SECONDARY_NAME=secondary
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=45000
# true = canned replies for local testing, no provider needed
AI_MOCK=false

# ---------- Speech-to-text ----------
# auto = N-ATLaS -> Whisper -> browser Web Speech API
STT_PROVIDER=auto
STT_PRIMARY_NAME=N-ATLaS
# e.g. http://stt:8000/v1 (compose --profile stt) or a RunPod endpoint serving /audio/transcriptions
STT_PRIMARY_BASE_URL=
STT_PRIMARY_API_KEY=
STT_PRIMARY_MODEL=NCAIR1/NigerianAccentedEnglish
STT_SECONDARY_NAME=Whisper
STT_SECONDARY_BASE_URL=
STT_SECONDARY_API_KEY=
STT_SECONDARY_MODEL=whisper-1
STT_CHUNK_SECONDS=8
STT_MAX_CHUNK_BYTES=2000000
STT_TIMEOUT_MS=30000
# stt sidecar only (gated NCAIR1 models: accept terms on Hugging Face)
HF_TOKEN=
STT_LANGS=en

# ---------- storage (VPS disk by default; any S3-compatible works) ----------
STORAGE_DRIVER=local
DATA_DIR=/data
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=25
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------- Bible ----------
BIBLE_API_BASE=https://bible.helloao.org/api
BIBLE_FALLBACK_BASE=https://bible-api.com
BIBLE_DEFAULT_TRANSLATION=eng_kjv
BIBLE_CACHE_DAYS=30
