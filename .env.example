# ---------- core ----------
APP_NAME=1venue
# The one public address of the app (no trailing slash). Everything else is derived from it:
# email links, the Google redirect ${PUBLIC_URL}/auth/google/callback, the default mail sender.
PUBLIC_URL=https://1venue.live
# Origins allowed to call the API cross-origin with cookies (comma separated). Empty = PUBLIC_URL only.
CORS_ORIGINS=
# Optional: 301-redirect every other host name (e.g. www.1venue.live) to this one. Empty = off.
# /health, /ready, /api/health and /metrics are never redirected. See docs/DEPLOY-1venue.live.md.
CANONICAL_HOST=1venue.live
PORT=3000
# Long random string (openssl rand -hex 32). Required in production. Signs the short-lived
# access token, room credentials and the Google sign-in flow cookie. Rotating it is safe:
# signed-in browsers renew from their refresh token (stored hashed in the database).
JWT_SECRET=
TRUST_PROXY=true
RATE_LIMIT_PER_MIN=240

# ---------- memory & live-room limits (Contabo-sized defaults) ----------
# V8 heap in MB. Keep ~65% of the container limit (APP_MEM_LIMIT): 2048 for 3g, 4096 for 6g.
NODE_MAX_OLD_SPACE_MB=2048
APP_MEM_LIMIT=3g
# Ping every WebSocket this often; sockets that miss a pong are closed (0 = off)
WS_HEARTBEAT_MS=30000
# Forget participants who left this long ago (hosts/co-hosts are kept). 0 = never
LEFT_PARTICIPANT_PRUNE_MINUTES=10
# Shared whiteboard: strokes kept per room / shared board, points kept per stroke
WB_MAX_STROKES=1000
WB_MAX_POINTS=2000
# Screen timeline snapshots per room, and max size of one snapshot (data-URL characters)
SCREEN_TIMELINE_MAX_ITEMS=10
SCREEN_TIMELINE_MAX_CHARS=1500000
# Graceful restarts: live rooms are saved on SIGTERM and every SNAPSHOT_INTERVAL_MS,
# then restored on boot (from snapshots and still-open meeting_history / billing rows).
# Snapshots older than this are ended instead of restored.
MEETING_RESTORE_MAX_MINUTES=30
SHUTDOWN_GRACE_MS=1500
# How long a new process waits after the previous worker goes quiet before it adopts
# or closes an unreconnected session. Keep Coolify's stop grace period at 30s or more
# (the process force-exits 8s after SIGTERM).
RESTART_ADOPT_GRACE_MS=15000
# Periodic snapshot interval in ms. 0 disables periodic writes (SIGTERM still snapshots).
SNAPSHOT_INTERVAL_MS=10000

# ---------- monitoring ----------
# GET /metrics (Prometheus text format) with header "Authorization: Bearer <METRICS_TOKEN>".
# Empty = /metrics is disabled (404). Generate with: openssl rand -hex 24
METRICS_TOKEN=
# One compact "[metrics] rss=… heap=… rooms=… participants=… sockets=… dead_sockets_total=… uptime=…" log line.
METRICS_LOG=true
METRICS_LOG_INTERVAL_MS=60000

# ---------- database (PostgreSQL; migrations run on boot) ----------
DATABASE_URL=postgres://venue:change-me@db:5432/venue
# Local testing only: set DB_DRIVER=sqlite and optionally SQLITE_PATH.
# Production keeps the default DB_DRIVER=postgres and DATABASE_URL above.
# DB_DRIVER=sqlite
# SQLITE_PATH=./data/venue.sqlite
AUTO_MIGRATE=true
DATABASE_POOL_MAX=10
DATABASE_SSL=false
# docker-compose only:
PG_MEM_LIMIT=1g
PG_SHARED_BUFFERS=256MB
PG_MAX_CONNECTIONS=60
PG_EFFECTIVE_CACHE_SIZE=1GB
POSTGRES_DB=venue
POSTGRES_USER=venue
POSTGRES_PASSWORD=change-me
# Only used if you add a host port mapping yourself
APP_PORT=8080

# ---------- accounts & sign-in (docs/AUTH.md) ----------
# Email + password sign-up on /signup (false = only existing users and Google sign-in)
ALLOW_LOCAL_SIGNUP=true
# Access token lifetime (minutes) and refresh session lifetime (days of inactivity / absolute max)
AUTH_ACCESS_TTL_MIN=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_SESSION_MAX_DAYS=90
# bcrypt cost (4-15). 12 is ~250 ms per hash on a modern core.
BCRYPT_COST=12
AUTH_PASSWORD_MIN=8
# false = people can use the app before confirming their email (they see a banner). true = they must confirm first.
AUTH_REQUIRE_VERIFIED_EMAIL=false
AUTH_VERIFY_TTL_HOURS=48
AUTH_RESET_TTL_MIN=60
# Sign-in/sign-up/reset requests per minute per IP (per process)
AUTH_RATE_PER_MIN=20
# Cookies are Secure (__Host- prefixed) unless PUBLIC_URL starts with http:// (local dev). Override only if you must.
# AUTH_COOKIE_SECURE=true

# --- Continue with Google (empty = button hidden) ---
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application).
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback  e.g. https://1venue.live/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# false = Google only signs in existing accounts (matched by verified email), never creates new ones
GOOGLE_ALLOW_SIGNUP=true

# --- Continue with Apple (empty = button hidden). Needs a paid Apple Developer account. ---
# Full steps: docs/APPLE_SIGNIN.md. Return URL to register: ${PUBLIC_URL}/auth/apple/callback
# The Services ID, e.g. live.1venue.signin (not the App ID)
APPLE_CLIENT_ID=
# Team ID: 10 characters, shown in developer.apple.com/account > Membership details
APPLE_TEAM_ID=
# Key ID: 10 characters, from the "Sign in with Apple" key
APPLE_KEY_ID=
# Contents of AuthKey_XXXXXXXXXX.p8. One line is fine: use \n for the line breaks.
APPLE_PRIVATE_KEY=
# false = Apple only signs in existing accounts (matched by email), never creates new ones
APPLE_ALLOW_SIGNUP=true
# Account deletion: minutes the emailed 6-digit code stays valid (5-60)
AUTH_DELETE_CODE_TTL_MIN=10

# ---------- email (any SMTP provider; examples in docs/AUTH.md) ----------
# Empty SMTP_HOST = no email is sent. Outside production the links are printed to the log instead.
SMTP_HOST=
SMTP_PORT=587
# Set when SMTP_HOST is an IP address; keeps TLS certificate validation on the SMTP hostname.
SMTP_TLS_SERVERNAME=
# true for port 465 (implicit TLS). Default: true only when SMTP_PORT=465. 587 uses STARTTLS.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# From address; must be allowed by your provider (a verified domain/sender). Default: "1venue <no-reply@PUBLIC_URL host>"
MAIL_FROM="1venue <no-reply@1venue.live>"
MAIL_REPLY_TO=
# Where email images (logo, laptop art) load from. Default: PUBLIC_URL when https, else https://1venue.live
MAIL_ASSET_URL=
# Print email links to the log when SMTP is not set (default: on outside production)
# MAIL_LOG_LINKS=true

# ---------- LiveKit (audio/video) ----------
# LiveKit runs as its own Coolify resource from the separate livekit-server repo
# (see docs/livekit-coolify.md). Use the API key/secret pair you created for 1venue there.
LIVEKIT_URL=wss://rtc.1venue.live
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMULCAST=true
DYNACAST=true
ADAPTIVE_STREAM=true
VIDEO_RESOLUTION=720p
VIDEO_MAX_BITRATE=1200000
VIDEO_MAX_FPS=24
SCREEN_MAX_BITRATE=1200000
SCREEN_MAX_FPS=12
AUDIO_PRESET=speech
MAX_PARTICIPANTS=50
MAX_AUDIENCE=300
DEFAULT_SPEAKER_SEATS=4
MEETING_INACTIVITY_HOURS=12

# ---------- AI (two OpenAI-compatible providers, each falls back to the other) ----------
# RunPod serverless vLLM example: https://api.runpod.ai/v2/<ENDPOINT_ID>/openai/v1
AI_PRIMARY_NAME=runpod
AI_PRIMARY_BASE_URL=
AI_PRIMARY_API_KEY=
AI_PRIMARY_MODEL=
AI_SECONDARY_NAME=secondary
AI_SECONDARY_BASE_URL=
AI_SECONDARY_API_KEY=
AI_SECONDARY_MODEL=
AI_MAX_TOKENS=900
AI_TIMEOUT_MS=45000
AI_FINETUNE_DAILY_LIMIT=20
# true = canned replies for local testing, no provider needed
AI_MOCK=false

# ---------- Speech-to-text ----------
# Any OpenAI-compatible POST {BASE_URL}/audio/transcriptions endpoint works. 1venue does NOT run
# a speech model itself (Contabo has no GPUs). Pick one:
#   Groq (cheapest hosted):  STT_SECONDARY_BASE_URL=https://api.groq.com/openai/v1
#                            STT_SECONDARY_MODEL=whisper-large-v3-turbo   STT_SECONDARY_API_KEY=<groq key>
#   OpenAI:                  STT_SECONDARY_BASE_URL=https://api.openai.com/v1  STT_SECONDARY_MODEL=whisper-1
#   RunPod GPU Pod running speaches (ghcr.io/speaches-ai/speaches:latest-cuda, port 8000):
#                            STT_PRIMARY_BASE_URL=https://<POD_ID>-8000.proxy.runpod.net/v1
#                            STT_PRIMARY_MODEL=Systran/faster-whisper-large-v3  STT_PRIMARY_API_KEY=<any non-empty>
#   Self-hosted N-ATLaS (optional, separate box): stt-sidecar/docker-compose.yml -> http://<host>:8000/v1
# Nothing configured (and no REPLICATE_API_TOKEN) = browsers fall back to the free Web Speech API.
# auto = Replicate Whisper (if REPLICATE_API_TOKEN) -> primary -> secondary -> browser Web Speech API
# replicate | natlas | whisper | webspeech | off force one engine
STT_PROVIDER=auto
STT_PRIMARY_NAME=N-ATLaS
STT_PRIMARY_BASE_URL=
STT_PRIMARY_API_KEY=
STT_PRIMARY_MODEL=NCAIR1/NigerianAccentedEnglish
STT_SECONDARY_NAME=Whisper
STT_SECONDARY_BASE_URL=
STT_SECONDARY_API_KEY=
STT_SECONDARY_MODEL=whisper-1
STT_CHUNK_SECONDS=8
STT_MAX_CHUNK_BYTES=2000000
STT_TIMEOUT_MS=30000
# stt-sidecar only (gated NCAIR1 models: accept terms on Hugging Face)
HF_TOKEN=
STT_LANGS=en

# ---------- Text-to-speech (read-out icon) - see docs/TTS.md ----------
# Server-side proxy to Replicate. The token stays on the server; browsers never see it.
# Empty token = cloud read-out off (the icon only shows where the device has a voice for that exact language).
REPLICATE_API_TOKEN=
# Model id: official model "owner/name" (or pin a version with "owner/name:versionhash")
TTS_REPLICATE_MODEL=google/gemini-3.8-flash-tts
# Materials → Analyse (PDF / Word / PowerPoint / CSV / Excel). Uses REPLICATE_API_TOKEN above; mock result
# when AI_MOCK=true or no token. Analysis is billed from the credit wallet. See docs/MATERIALS.md.
# REPLICATE_MODEL=meta/llama-4-scout-instruct
# MATERIAL_ANALYSIS_TIMEOUT_MS=90000
# MATERIAL_ANALYSIS_MAX_CHARS=12000
# REPLICATE_API_BASE=https://api.replicate.com/v1
# Voice (one of the model's 30 voices: Kore, Puck, Charon, Zephyr, Aoede, ...) and audio format
TTS_VOICE=Kore
TTS_FORMAT=mp3
# Max characters per request (longer passages are split into chunks by the browser)
TTS_MAX_CHARS=1500
# New (uncached) generations per participant/user per minute. Cached audio is free and not limited.
TTS_RATE_PER_MIN=10
# Whole-server cap on newly generated characters per day (UTC). 0 = no cap.
TTS_DAILY_CHAR_LIMIT=200000
TTS_TIMEOUT_MS=90000
TTS_MAX_AUDIO_MB=20
# Languages the CLOUD voice is used for (comma-separated; ig, ig-NG, ibo or igbo all work).
# The device's own voice is always tried first, so English etc. need no cloud. Empty = every
# language the model documents (includes ig, ha, ar; NOT yo). Recommended: ig,ha,ar
TTS_LANGUAGES=ig,ha,ar

# ---------- Voice typing + captions on Replicate Whisper (main STT) - see docs/VOICE_AND_COVERS.md ----------
# Uses REPLICATE_API_TOKEN (above). With a token, Whisper on Replicate is the main engine for the / bar,
# every text box and meeting captions; providers above are fallbacks; the browser Web Speech API is the last one.
# Model: vaibhavs10/incredibly-fast-whisper (L40S, ~US$0.000975/s of GPU time, ~US$0.012 per minute of speech).
# Cheaper but much slower alternative: STT_REPLICATE_MODEL=openai/whisper:<version>
STT_REPLICATE_MODEL=vaibhavs10/incredibly-fast-whisper:c6433aab18b7318bbae316495f1a097fc067deef7d59dc2f33e45077ae5956c7
STT_REPLICATE_TIMEOUT_MS=20000
# Daily caps in seconds of speech (UTC day). Over a cap the browser falls back to Web Speech.
STT_DAILY_SECONDS_PER_USER=1200
STT_DAILY_CAPTION_SECONDS_PER_USER=3600
STT_DAILY_SECONDS_TOTAL=36000
# Browser cuts a clip at a pause, or after this many seconds of continuous speech
STT_SEGMENT_MAX_SECONDS=5

# ---------- AI event covers (create event → Cover → Design with AI) ----------
# flux-schnell on Replicate (~US$0.003 per image), 16:9, text-free. Only the picked image is saved.
AI_COVER_MODEL=ideogram-ai/ideogram-v3-turbo
# Generations per user per day (one image each); 0 = off
AI_COVER_DAILY_LIMIT=10
AI_COVER_TIMEOUT_MS=60000
# Cheap text embedding model for the AI cover library
AI_EMBED_MODEL=nateraw/bge-large-en-v1.5
# Minimum cosine similarity to reuse a library cover (0-1)
AI_COVER_REUSE_MIN=0.85

# ---------- storage (VPS disk by default; any S3-compatible works) ----------
STORAGE_DRIVER=local
DATA_DIR=/data
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=25
# Per-type limits (MB). 0 turns a type off. Unset uses the code default (video 200 MB / 15 minutes).
# Videos go direct to R2 (presigned PUT), so they are not capped by MAX_UPLOAD_MB. An explicit 0 still disables video.
UPLOAD_MAX_IMAGE_MB=8
UPLOAD_MAX_PDF_MB=20
UPLOAD_MAX_AUDIO_MB=10
UPLOAD_MAX_VIDEO_MB=200
UPLOAD_MAX_VIDEO_SEC=900
UPLOAD_MAX_OTHER_MB=10
# 1venue whiteboard files (.mwb, gzip JSON) shared in Messages
UPLOAD_MAX_BOARD_MB=25
# Total stored per signed-in user / per guest, and per meeting (MB)
UPLOAD_USER_QUOTA_MB=250
UPLOAD_GUEST_QUOTA_MB=30
UPLOAD_MEETING_CAP_MB=150
# Upload rate limits per user (or IP for guests)
UPLOAD_RATE_PER_MIN=12
# Deck pages (purpose=content: PDF pages / image sets for Materials and presenting) use their own, higher limits.
# UPLOAD_CONTENT_RATE_PER_MIN=240
# UPLOAD_CONTENT_RATE_PER_HOUR=480
# UPLOAD_LOG=false silences the per-upload "[upload] …" info lines (warnings / errors always print).
UPLOAD_RATE_PER_HOUR=120
# Inline (data URL) chat attachments over the socket. 0 = off (current clients upload files).
CHAT_INLINE_MAX_MB=0

# --- S3-compatible object storage (recommended: Cloudflare R2) ---
# Set STORAGE_DRIVER=s3 above to use it. Files uploaded earlier stay readable from STORAGE_DIR
# (each file row remembers its driver), so keep the /data volume after switching.
# Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com   (R2 > Overview > "S3 API")
#   S3_REGION=auto
#   S3_BUCKET=1venue-uploads
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from R2 > Manage API tokens (Object Read & Write, this bucket only)
#   S3_FORCE_PATH_STYLE=true
#   S3_PUBLIC_BASE_URL=https://files.1venue.live   (bucket custom domain; files then load from
#   Cloudflare, not this server). Leave empty to stream files through the app instead.
#   The custom domain must be connected to the bucket (R2 > bucket > Settings > Custom Domains) so
#   https://files.1venue.live/<key> answers 200. Materials and presented slides accept these URLs.
# AWS S3: leave S3_ENDPOINT empty and set S3_REGION (e.g. eu-west-1). Backblaze B2 / MinIO: their S3 endpoint.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

# ---------- Bible ----------
BIBLE_API_BASE=https://bible.helloao.org/api
BIBLE_FALLBACK_BASE=https://bible-api.com
BIBLE_DEFAULT_TRANSLATION=eng_kjv
BIBLE_CACHE_DAYS=30

# ---------- admin ----------
# Comma-separated emails that may open /admin (demo data load/remove, read-out check).
# The email must be confirmed on that account (Google sign-in counts).
ADMIN_EMAILS=

# ---------- Credit wallets / Paystack hosted checkout ----------
# 1 credit = ₦10 (CREDIT_PRICE_KOBO=1000). Packs: 500, 1,500, 3,000, 6,000. Custom whole-credit purchases too.
# Use a separate test database and sk_test_... key locally. NODE_ENV=production needs sk_live_...
# A configured PUBLIC_URL is required for the return to /wallet.
PAYSTACK_SECRET_KEY=
# Modern webhook signing secret (whsec_...). If set, modern signatures are required.
# Without it, the legacy x-paystack-signature is validated using PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
# Confirms the fee setup: with PROCESSING_FEE_PERCENT > 0 turn OFF Paystack "Pass fees to customers".
# Purchases stay disabled until this is true.
# Case-insensitive; true / TRUE / True all work.
PAYSTACK_PASS_FEES_CONFIRMED=false
# Webhook URL: https://your-domain/payments/paystack/webhook
# Optional sandbox (e.g. Bannk): PAYSTACK_BASE_URL=https://bannk.beuden.com.ng with an sk_test_ key.
# Leave empty for real Paystack (https://api.paystack.co). Only https + sk_test_ is accepted for a sandbox.
PAYSTACK_BASE_URL=

# ---------- Currency, processing fee, auto top-up (docs/CURRENCY.md) ----------
# Prices are stored and charged in CURRENCY_BASE; other currencies are display prices.
CURRENCY_BASE=NGN
# Units of each currency per 1 NGN. PLACEHOLDER values: replace with real rates (or edit in /admin).
FX_RATES={"USD":0.00062,"GBP":0.00049,"EUR":0.00057,"GHS":0.0095,"KES":0.08,"ZAR":0.0112,"CAD":0.00087}
# Added to every paid checkout (0-20). Turn off Paystack "Pass fees to customers" when this is above 0.
PROCESSING_FEE_PERCENT=4

# ---------- Credit price, meeting billing, plans (docs/PLANS-BILLING.md) ----------
# One wallet for meetings and AI. 1 credit = ₦10. Bill meetings per second after the free window.
CREDIT_PRICE_KOBO=1000
CREDIT_BUNDLES=500,1500,3000,6000
BILLING_WELCOME_CREDITS=100
BILLING_FREE_MINUTES=20
# Host pays for everyone on free entry (including venues). Room rate covers host + 1 other person.
MEETING_ROOM_CREDITS_PER_MIN=1.5
MEETING_PUBLISHER_CREDITS_PER_MIN=0.3
MEETING_VIEWER_CREDITS_PER_MIN=0.1
# Paid entry: each participant pays the room rate; host still pays the room rate. 80% of participant usage goes to the host.
PAID_ENTRY_HOST_SHARE_BPS=8000
# AI is billed from the same wallet. These are internal rates — do not show them in the UI.
AI_CREDIT_ASK=1
AI_CREDIT_TRANSLATE=1
AI_CREDIT_TITLE=1
AI_CREDIT_SCRIPTURE=1
AI_CREDIT_SUMMARY=1
AI_CREDIT_CATCHUP=1
AI_CREDIT_FINETUNE=1
AI_CREDIT_ANALYSIS=1
AI_CREDIT_TRANSCRIBE=1
AI_CREDIT_COVER=10
AI_CREDIT_WHITEBOARD_AI=15
AI_CREDIT_STT_PER_MIN=2
AI_CREDIT_TTS_PER_1K=5
# Light per-user abuse guard (not a daily allowance shown to users).
AI_RATE_PER_USER_HOURLY=60
# Monthly plan allotments (unused plan credits expire after 1 month; purchased credits never expire).
PLAN_PRO_INCLUDED_CREDITS=2000
PLAN_BUSINESS_INCLUDED_CREDITS=5000
PLAN_ORGANISATION_INCLUDED_CREDITS=12000
# Plan prices in kobo. Yearly is 10x monthly (2 months free).
PLAN_PRO_PRICE_MONTH_KOBO=1500000
PLAN_PRO_PRICE_YEAR_KOBO=15000000
PLAN_BUSINESS_PRICE_MONTH_KOBO=3500000
PLAN_BUSINESS_PRICE_YEAR_KOBO=35000000
PLAN_ORGANISATION_PRICE_MONTH_KOBO=7500000
PLAN_ORGANISATION_PRICE_YEAR_KOBO=75000000
# Enterprise "Talk to sales" form emails this address (falls back to the first ADMIN_EMAILS entry).
SALES_EMAIL=

AUTO_TOPUP=true
AUTO_TOPUP_MAX_FAILURES=3
AUTO_TOPUP_RETRY_MS=3600000
# Short links: 4-character and 3-character add-on prices (kobo); released this many days after a plan lapses.
LINK4_PRICE_KOBO=1000000
LINK3_PRICE_KOBO=2500000
SHORT_LINK_RELEASE_DAYS=60

# ---------- Phase 2/3: premium, commerce, orgs, replays (docs/PHASE2-3.md) ----------
# Plan features, the platform fee (5%), promotion price, payout minimum, reminder times etc. are edited in
# /admin -> Plans. Env is only a fallback: PLAN_<PLAN>_<FEATURE>=1/0 (e.g. PLAN_PRO_TICKETING=1),
# PLATFORM_<SETTING>=n (e.g. PLATFORM_FEE_BPS=500, PLATFORM_PROMO_DAY_KOBO=100000,
# PLATFORM_PROMO_MAX_DAYS=90).
# Per-placement promotion rates (kobo / day). Profile is a fifth placement; default ₦150/day.
# PROMO_RATE_DISCOVER_KOBO=35000
# PROMO_RATE_FEED_KOBO=30000
# PROMO_RATE_VENUES_KOBO=20000
# PROMO_RATE_BOOKS_KOBO=15000
PROMO_RATE_PROFILE_KOBO=15000
# Reminders (email 24h + 1h before). Claimed per send, so restarts never double-send.
REMINDER_WORKER=true
REMINDER_TICK_MS=60000
REMINDER_TIMEZONE=Africa/Lagos
# WhatsApp reminders via Meta Cloud API (off unless both are set). Needs an approved template with
# three body parameters: event name, time, link.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=event_reminder
WHATSAPP_TEMPLATE_LANG=en
# Cloud replays through self-hosted LiveKit Egress (room composite MP4 -> R2). Needs STORAGE_DRIVER=s3.
LIVEKIT_EGRESS_ENABLED=false
# LIVEKIT_API_URL=https://rtc.1venue.live
# EGRESS_S3_ACCESS_KEY_ID=          # defaults to S3_ACCESS_KEY_ID
# EGRESS_S3_SECRET_ACCESS_KEY=      # defaults to S3_SECRET_ACCESS_KEY
# EGRESS_LAYOUT=speaker
# REPLAY_POLL_MS=60000
# false = always stream replays through the app (ticketed/private replays stay unguessable)
# REPLAY_PUBLIC_REDIRECT=true

# ---- Messages power features (inbox tabs, pins, scheduled messages, voice-note transcription, file AI)
# Voice-note transcription model on Replicate (uses REPLICATE_API_TOKEN). Empty = reuse STT_REPLICATE_MODEL.
REPLICATE_STT_MODEL=
# Voice-note transcription and whiteboard refine are billed from the credit wallet.
WHITEBOARD_AI_MODEL=black-forest-labs/flux-kontext-pro
WHITEBOARD_AI_TIMEOUT_MS=120000
MESSAGES_STT_TIMEOUT_MS=120000
MESSAGES_STT_MAX_MB=25
# How often the scheduled-messages worker checks for due messages (ms); MESSAGES_SCHEDULER=false disables it
MESSAGES_SCHEDULER_MS=15000
MESSAGES_SCHEDULER=true
# "New chat by username or email" lookups per user per minute
MESSAGES_LOOKUPS_PER_MIN=20

# ---- Notification inbox, transactional mail, and AI voice calls
# Optional event/invite/RSVP emails (security mail always sends when SMTP is set)
NOTIFY_EMAIL_ENABLED=true
# Replicate chat replies in the pinned Notification thread (falls back to venue AI or a canned line)
NOTIFY_AI_ENABLED=true
# NOTIFY_AI_MODEL=                  # defaults to REPLICATE_MODEL (meta/llama-4-scout-instruct)
NOTIFY_AI_DAILY_LIMIT=40
NOTIFY_USERNAME=notification
NOTIFY_RETURN_AFTER_DAYS=3
# In-app voice calls from Notification. Default off until LiveKit + Replicate STT/TTS are ready.
AI_CALLS_ENABLED=false
AI_CALLS_MAX_MINUTES=10
AI_CALLS_PER_HOUR=1
AI_CALLS_PER_DAY=3
AI_CALLS_URGENT_WINDOW_MIN=120
# NOTIFY_WORKER=false               # disable invite/event-live reminder worker
# NOTIFY_TICK_MS=60000
# End-of-turn silence is an admin setting (platform.aiCallSilenceMs), default 1500 ms.

# Paid Entry reconnect/grace windows. Usage rates are MEETING_* and PAID_ENTRY_HOST_SHARE_BPS above.
PAID_USAGE_RECONNECT_MS=30000
PAID_USAGE_GRACE_MS=120000
PAID_SWITCH_ACCEPT_MS=300000
GUEST_INSTANT_PER_IP_HOUR=3
