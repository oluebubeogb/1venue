{
  "name": "1venue",
  "version": "1.0.0",
  "private": true,
  "description": "1venue: premium virtual events and meetings on the Collab suite, built on Meet with LiveKit and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test test/",
