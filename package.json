{
  "name": "1venue",
  "version": "1.0.2",
  "private": true,
  "description": "1venue: live events and online meetings for churches, communities, conferences and classes, built with LiveKit and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:sqlite": "DB_DRIVER=sqlite AI_MOCK=true node --watch server.js",
    "migrate": "node scripts/migrate.js",
    "test": "node --test test/*.test.js",
    "test:sqlite": "DB_DRIVER=sqlite node --test test/*.test.js",
    "icons": "python3 scripts/build-icons.py",
    "migrate:sqlite-to-pg": "node scripts/migrate-sqlite-to-pg.js",
    "livekit:check": "node scripts/livekit-check.js",
    "migration:new": "node scripts/new-migration.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "^1.13.16",
    "livekit-client": "^2.9.1",
    "livekit-server-sdk": "^2.9.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1"
  }
}
