    "livekit:check": "node scripts/livekit-check.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "livekit-client": "^2.9.1",
    "livekit-server-sdk": "^2.9.1",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
